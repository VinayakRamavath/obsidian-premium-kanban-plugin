filters:
  and:
    - file.inFolder("todos")
views:
  - type: premium-kanban
    name: Premium Kanban
    groupBy:
      property: Status
      direction: DESC
    order:
      - file.name
      - Project
      - source
      - Due
    columnOrder: Today,In Progress,Inbox,Not Started,Backlog,Completed
    columnColors: '{"Today":"#d97706","In Progress":"#7c5ce7","Inbox":"#168aad","Not Started":"#3b82f6","Backlog":"#d97706","Completed":"#16a068"}'
  - type: table
    name: Fixture table
    groupBy:
      property: Status
      direction: DESC
    order:
      - file.name
      - Project
      - source
